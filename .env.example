# ==============================================================================
# NEXUS GATEWAY - SPRINT 1 ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# 1. Supabase Credentials (Task S1-1, S1-2, S1-4, S1-7, S1-9, S1-10)
# Obtain from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Upstash Redis Credentials (Task S1-5: JWT guard & Redis session checks)
# Obtain from: https://upstash.com -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# 3. Application URL (used for OAuth redirects and email verification links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
